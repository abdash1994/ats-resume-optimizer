  "universal_rules": {
    "always_avoid": [
      "Tables for layout",
      "Text boxes",
      "Headers and footers (content, not section headers)",
      "Images and graphics",
      "Charts and infographics",
      "Multiple columns (for most systems)",
      "Fancy fonts (stick to standard fonts)",
      "Special Unicode characters in important fields",
      "Hyperlinks embedded in text (write out URLs)",
      "Text in shapes",
      "Watermarks"
    ],
    "always_include": [
      "Full name prominently at top",
      "Professional email address",
      "Phone number with country code",
      "City and State/Country",
      "LinkedIn URL",
      "Work Experience section",
      "Education section",
      "Skills section"
    ],
    "keyword_best_practices": [
      "Use exact keywords from job description",
      "Include both spelled-out and acronym versions (e.g., Machine Learning and ML)",
      "Repeat top keywords 2-4 times naturally",
      "Place most important keywords in Summary and first bullet of each role",
      "Match seniority language (e.g., 'led', 'managed', 'architected' for senior roles)",
      "Include industry-specific terms"
    ],
    "bullet_point_rules": [
      "Start with strong action verb",
      "Include quantified results where possible (%, $, numbers)",
      "Keep bullets to 1-2 lines",
      "Focus on impact not just duties",
      "Use past tense for previous roles, present for current"
    ],
    "section_order": [
      "Contact Information",
      "Professional Summary",
      "Work Experience",
      "Education",
      "Skills",
      "Certifications",
      "Projects",
      "Awards",
      "Publications"
    ]
  }
